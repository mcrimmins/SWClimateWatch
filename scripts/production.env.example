# Copy to /home/crimmins/.config/swclimatewatch/production.env on the VM.
# This is Bash syntax. Keep the installed copy private (chmod 600).
# Confirm command paths on the VM with: command -v Rscript quarto aws
PATH=/usr/local/bin:/usr/bin:/bin
SWC_S3_DESTINATION=s3://cales-climate-reports/climate/watch-staging/
SWC_PRODUCTION_STATE_DIR=/home/crimmins/.local/state/swclimatewatch
# Optional if Rscript is not on PATH:
# SWC_RSCRIPT=/absolute/path/to/Rscript
# Enable the existing phone alerts in the installed configuration:
# SWC_NTFY_TOPIC=sw-climate-watch-notifications
# SWC_NTFY_TOKEN=your-token-if-required
# Optional weather-map integration; leave off until its staging trial passes.
# SWC_WEATHER_MAPS=true
# Cached 7-/30-day weather means; enable after the staging workflow test.
# SWC_WEATHER_PERIOD_MEANS=true
# Maximum newly built/revised endpoints per daily run (0-30).
# SWC_WEATHER_MEANS_MAX_NEW_DATES=3
